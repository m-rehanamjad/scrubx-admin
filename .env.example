# Supabase -> Connect -> Transaction pooler URI (port 6543).
# Use a privileged server-only DB user; RLS has intentionally no public policies.
# URL-encode special characters in the database password. Never use NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Exact browser-facing origin. For Arena use the HTTPS preview origin, not localhost.
BETTER_AUTH_URL=http://localhost:3000
# One-time bootstrap only. Remove ADMIN_PASSWORD after running npm run admin:create.
ADMIN_EMAIL=
ADMIN_NAME=Store Admin
ADMIN_PASSWORD=
